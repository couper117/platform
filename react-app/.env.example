# Backend API base URL.
# Leave unset to use the default below, which pairs with the Vite dev proxy
# and the API's own PORT=5000 default.
VITE_API_URL=http://localhost:5000/api/v1

# Pusher (real-time scores and match events).
# Must match PUSHER_KEY / PUSHER_CLUSTER in api/.env.
# If VITE_PUSHER_KEY is unset, the app renders fine but without live updates.
VITE_PUSHER_KEY=your_pusher_key
VITE_PUSHER_CLUSTER=your_pusher_cluster

# Static showcase build. When set to the string "true", the axios client is
# swapped for a local mock adapter and no backend is contacted.
# Leave unset (or "false") for normal development and production builds.
VITE_DEMO=false

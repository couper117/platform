{
  "name": "rnsp-platform",
  "version": "1.0.0",
  "description": "Rwanda National Sports Platform (RNSP / RwaSport) — monorepo",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "demo/app"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend\"",
    "build": "npm run build --workspace=apps/frontend",
    "start": "concurrently -n backend,frontend -c green,cyan \"npm run start --workspace=apps/backend\" \"npm run start --workspace=apps/frontend\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "demo:dev": "npm run dev --workspace=demo/app",
    "demo:build": "npm run build --workspace=demo/app",
    "demo:serve": "node demo/serve.js",
    "seed": "npm run seed --workspace=apps/backend",
    "seed:all": "npm run seed:all --workspace=apps/backend",
    "typecheck": "npm run typecheck --workspace=apps/frontend && npm run typecheck --workspace=apps/backend",
    "lint": "npm run lint --workspace=apps/frontend",
    "test": "npm run test --workspace=apps/backend && npm run test --workspace=apps/frontend",
    "test:smoke": "npm run test:smoke --workspace=apps/backend",
    "check:drift": "node scripts/check-demo-drift.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "privacy:purge": "tsx scripts/purge-expired-data.mjs",
    "privacy:purge:apply": "tsx scripts/purge-expired-data.mjs --apply",
    "install:all": "npm install",
    "prepare": "husky || true",
    "dev:demo": "npm run dev:demo --workspace=apps/frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "sharp@0.35.3": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "prisma@5.22.0": true,
    "@scarf/scarf@1.4.0": true
  }
}

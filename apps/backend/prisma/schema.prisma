// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App connects through the connection POOLER (Supabase Supavisor, port 6543,
  // pgbouncer=true). directUrl is the DIRECT/session connection (port 5432) that
  // `prisma migrate`/`db push` use â€” a transaction pooler can't run migrations.
  // In local dev both point at the same cluster (DIRECT_DATABASE_URL falls back
  // to DATABASE_URL when unset â€” see config/env.ts).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Setting {
  id       Int     @id @default(autoincrement())
  skey     String  @unique @db.VarChar(100)
  sval     String? @db.Text
  label    String? @db.VarChar(200)
  grp      String  @default("general") @db.VarChar(80)
  isPublic Boolean @default(true)
}

model Ad {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  targetUrl String?
  position  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(80)
  password  String    @db.VarChar(255)
  fullName  String    @db.VarChar(200)
  email     String?   @unique @db.VarChar(200)
  phone     String?   @db.VarChar(50)
  role      Role      @default(PUBLIC)
  active    Boolean   @default(true)
  verified  Boolean   @default(false)
  avatar    String?   @db.VarChar(300)
  lastLogin DateTime?
  createdAt DateTime  @default(now())

  resetTokenHash   String?   @db.VarChar(128)
  resetTokenExpiry DateTime?

  managedTeam  Team?  @relation("TeamManager")
  newsArticles News[]

  // A SCHOOL_COORDINATOR registers athletes for exactly one school. Every query
  // that role makes is scoped to this id — see middleware/auth.ts.
  akcSchoolId   Int?
  akcSchool     AkcSchool?     @relation(fields: [akcSchoolId], references: [id], onDelete: SetNull)
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]

  leaguesManaged     LeagueAdminAssignment[]
  federationsManaged FederationAdminAssignment[]
  matchAssignments   ReporterAssignment[]
  umugandaDays       UmugandaDay[]               @relation("UmugandaAuthor")

  // ── Capabilities ──
  // The role stays the coarse grain, so every existing authorize() call keeps
  // working. These two lists are per-account exceptions on top of it: a grant
  // adds a capability the role lacks, a revoke takes away one it would otherwise
  // have. Deliberately not a Permission/RolePermission matrix — the role to
  // capability map belongs in code where it can be read, diffed and unit-tested,
  // and only the exceptions need a row.
  grantedCapabilities String[] @default([])
  revokedCapabilities String[] @default([])

  reporterProfile  ReporterProfile?
  notifications    Notification[]
  favorites        Favorite[]
  uploadedMedia    Media[]           @relation("MediaUploader")
  reviewedRequests PlatformRequest[] @relation("RequestReviewer")
}

enum Role {
  SUPERADMIN
  FEDERATION_ADMIN
  AMASHURI_ADMIN
  SCHOOL_COORDINATOR
  LEAGUE_ADMIN
  MATCH_REPORTER
  TEAM_MANAGER
  PUBLIC
}

model FederationAdminAssignment {
  id           Int        @id @default(autoincrement())
  federationId Int
  federation   Federation @relation(fields: [federationId], references: [id], onDelete: Cascade)
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   Int?
  assignedAt   DateTime   @default(now())

  @@unique([federationId, userId])
  @@index([userId])
}

model LeagueAdminAssignment {
  id         Int      @id @default(autoincrement())
  leagueId   Int
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy Int? // Superadmin ID
  assignedAt DateTime @default(now())

  @@unique([leagueId, userId])
  @@index([userId])
}

model ReporterAssignment {
  id         Int      @id @default(autoincrement())
  leagueId   Int?
  league     League?  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  fixtureId  Int?
  fixture    Fixture? @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy Int? // League Admin ID
  assignedAt DateTime @default(now())

  @@unique([leagueId, userId])
  @@unique([fixtureId, userId])
  @@index([userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Sport {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(150)
  slug        String?       @db.VarChar(170)
  icon        String        @default("") @db.VarChar(10)
  description String?       @db.Text
  coverImage  String?       @db.VarChar(300)
  category    SportCategory @default(OTHER)
  type        SportType     @default(TEAM) // how the sport is competed/managed
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  leagues     League[]
  teams       Team[]
  federations Federation[]
  races       Race[]
}

enum SportCategory {
  FIELD
  COURT
  TRACK
  WATER
  COMBAT
  RACKET
  OTHER
}

// Governs how a sport is managed in the admin: team-vs-team matches, mass-start
// races/individual events, weight-class combat bouts, or 1v1 racket/board ties.
enum SportType {
  TEAM
  RACING
  COMBAT
  RACKET
}

model Federation {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  abbreviation String?  @db.VarChar(20)
  sportId      Int?
  sport        Sport?   @relation(fields: [sportId], references: [id], onDelete: SetNull)
  logo         String?  @db.VarChar(300)
  description  String?  @db.Text
  website      String?  @db.VarChar(300)
  email        String?  @db.VarChar(200)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  leagues League[]
  admins  FederationAdminAssignment[]

  @@index([sportId])
}

model League {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(200)
  slug         String?      @db.VarChar(220)
  sportId      Int
  sport        Sport        @relation(fields: [sportId], references: [id])
  federationId Int?
  federation   Federation?  @relation(fields: [federationId], references: [id], onDelete: SetNull)
  season       String       @default("2025/2026") @db.VarChar(50)
  gender       Gender       @default(MALE)
  ageCategory  AgeCategory  @default(SENIOR)
  level        CompLevel    @default(NATIONAL)
  format       LeagueFormat @default(LEAGUE)
  status       LeagueStatus @default(UPCOMING)
  maxTeams     Int          @default(16)
  description  String?      @db.Text
  startDate    DateTime?
  endDate      DateTime?
  adminUserId  Int?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  teams         LeagueTeam[]
  fixtures      Fixture[]
  standings     Standing[]
  topScorers    TopScorer[]
  competitions  Competition[]
  registrations TeamRegistration[]
  news          News[]

  admins            LeagueAdminAssignment[]
  assignedReporters ReporterAssignment[]

  races          Race[]
  classification Classification?

  @@index([sportId])
  @@index([federationId])
}

enum Gender {
  MALE
  FEMALE
  MIXED
  DISABLED
}

enum AgeCategory {
  SENIOR
  U20
  U17
  U15
  U13
  JUNIOR
  VETERAN
  ALL
}

enum CompLevel {
  NATIONAL
  REGIONAL
  DISTRICT
  SCHOOL
}

enum LeagueFormat {
  LEAGUE
  KNOCKOUT
  GROUP_KNOCKOUT
  ROUND_ROBIN
}

enum LeagueStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  SUSPENDED
}

model Team {
  id                 Int        @id @default(autoincrement())
  name               String     @db.VarChar(200)
  shortName          String?    @db.VarChar(10)
  slug               String?    @unique @db.VarChar(220)
  sportId            Int?
  sport              Sport?     @relation(fields: [sportId], references: [id], onDelete: SetNull)
  logo               String?    @db.VarChar(300)
  foundedYear        Int?
  homeVenue          String?    @db.VarChar(300)
  city               String?    @db.VarChar(150)
  district           String?    @db.VarChar(100)
  province           String?    @db.VarChar(100)
  registrationNo     String?    @db.VarChar(60) // federation club registration number
  primaryColor       String?    @db.VarChar(30)
  secondaryColor     String?    @db.VarChar(30)
  description        String?    @db.Text
  email              String?    @db.VarChar(200)
  phone              String?    @db.VarChar(50)
  website            String?    @db.VarChar(300)
  managerUserId      Int?       @unique
  managerUser        User?      @relation("TeamManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  status             TeamStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         Int?
  active             Boolean    @default(true)
  subscriptionActive Boolean    @default(false)
  subscriptionUntil  DateTime?
  createdAt          DateTime   @default(now())

  leagues       LeagueTeam[]
  players       Player[]
  homeFixtures  Fixture[]          @relation("HomeTeam")
  awayFixtures  Fixture[]          @relation("AwayTeam")
  standings     Standing[]
  topScorers    TopScorer[]
  registrations TeamRegistration[]
  transfersFrom Transfer[]         @relation("TransferFrom")
  transfersTo   Transfer[]         @relation("TransferTo")
  officials     TeamOfficial[]
  favorites     Favorite[]

  @@index([sportId])
}

enum TeamStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

model TeamOfficial {
  id        Int          @id @default(autoincrement())
  teamId    Int
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      OfficialRole @default(OTHER)
  fullName  String       @db.VarChar(200)
  phone     String?      @db.VarChar(50)
  email     String?      @db.VarChar(200)
  idNumber  String?      @db.VarChar(60)
  createdAt DateTime     @default(now())

  @@index([teamId])
}

enum OfficialRole {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  MANAGER
  HEAD_COACH
  ASSISTANT_COACH
  TEAM_DOCTOR
  OTHER
}

model LeagueTeam {
  id       Int      @id @default(autoincrement())
  leagueId Int
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId   Int
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([leagueId, teamId])
  @@index([teamId])
}

model Player {
  id           Int          @id @default(autoincrement())
  teamId       Int
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName     String       @db.VarChar(200)
  photo        String?      @db.VarChar(300)
  dateOfBirth  DateTime?    @db.Date
  nationality  String       @default("Rwandan") @db.VarChar(100)
  idNumber     String?      @db.VarChar(60) // national ID / passport number
  licenseNo    String?      @db.VarChar(60) // federation player licence number
  position     String?      @db.VarChar(100)
  jerseyNumber Int?         @db.SmallInt
  skillLevel   PlayerSkill  @default(AMATEUR)
  gender       PlayerGender @default(MALE)
  height       Int?
  weight       Int?
  bio          String?      @db.Text
  status       PlayerStatus @default(PENDING)
  verifiedAt   DateTime?
  verifiedBy   Int?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  documents     PlayerDocument[]
  lineups       Lineup[]
  topScorer     TopScorer?
  events        MatchEvent[]     @relation("PlayerEvent")
  subEvents     MatchEvent[]     @relation("SubEvent")
  transfersFrom Transfer[]
  suspensions   Suspension[]

  @@index([teamId])
}

model Suspension {
  id              Int              @id @default(autoincrement())
  playerId        Int
  player          Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  reason          SuspensionReason @default(RED_CARD)
  matches         Int              @default(1) // number of matches banned
  matchesServed   Int              @default(0)
  active          Boolean          @default(true)
  originFixtureId Int?
  note            String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([playerId])
}

enum SuspensionReason {
  RED_CARD
  YELLOW_ACCUMULATION
  MISCONDUCT
  OTHER
}

enum PlayerSkill {
  ELITE
  PROFESSIONAL
  SEMI_PROFESSIONAL
  AMATEUR
}

enum PlayerGender {
  MALE
  FEMALE
}

enum PlayerStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

model PlayerDocument {
  id           Int       @id @default(autoincrement())
  playerId     Int
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  docType      DocType
  filename     String    @db.VarChar(300)
  originalName String?   @db.VarChar(300)
  fileSize     Int?
  mimeType     String?   @db.VarChar(100)
  status       DocStatus @default(PENDING)
  reviewNote   String?   @db.Text
  reviewedBy   Int?
  uploadedAt   DateTime  @default(now())

  @@index([playerId])
}

enum DocType {
  BIRTH_CERTIFICATE
  PASSPORT
  NATIONAL_ID
  MEDICAL
  OTHER
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

model Venue {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(200)
  city     String? @db.VarChar(150)
  province String? @db.VarChar(100)
  capacity Int?
  surface  String? @db.VarChar(100)
  active   Boolean @default(true)
}

model Competition {
  id        Int       @id @default(autoincrement())
  leagueId  Int
  league    League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(200)
  roundType RoundType @default(REGULAR)
  sortOrder Int       @default(0)

  fixtures Fixture[]

  @@index([leagueId])
}

enum RoundType {
  GROUP
  KNOCKOUT
  FINAL
  SEMI_FINAL
  QUARTER_FINAL
  REGULAR
}

model Fixture {
  id            Int           @id @default(autoincrement())
  leagueId      Int
  league        League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  competitionId Int?
  competition   Competition?  @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  homeTeamId    Int
  homeTeam      Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    Int
  awayTeam      Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchday      Int           @default(1) @db.SmallInt
  venue         String?       @db.VarChar(300)
  matchDate     DateTime?
  status        FixtureStatus @default(SCHEDULED)
  homeScore     Int?          @db.SmallInt
  awayScore     Int?          @db.SmallInt
  homeScoreHt   Int?          @db.SmallInt
  awayScoreHt   Int?          @db.SmallInt
  attendance    Int?
  referee       String?       @db.VarChar(200)
  matchNotes    String?       @db.Text
  streamUrl     String?       @db.VarChar(500)
  streamActive  Boolean       @default(false)
  createdAt     DateTime      @default(now())

  // ── Umuganda awareness ──
  // originalMatchDate is written ONCE, the first time a fixture is moved, so the
  // date users originally saw survives any number of later reschedules.
  umugandaDayId     Int?
  umugandaDay       UmugandaDay?      @relation(fields: [umugandaDayId], references: [id], onDelete: SetNull)
  umugandaDecision  UmugandaDecision?
  originalMatchDate DateTime?
  rescheduleReason  String?           @db.VarChar(500)

  events     MatchEvent[]
  lineups    Lineup[]
  liveState  LiveMatchState?
  teamSheets MatchTeamSheet[]
  stats      MatchStat[]

  assignedReporters ReporterAssignment[]

  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([competitionId])
  @@index([umugandaDayId])
  @@index([matchDate])
}

enum FixtureStatus {
  SCHEDULED
  CONFIRMED
  UMUGANDA_CONFLICT
  RESCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

// Per-team team sheet for a fixture: formation, coach and publish state. The
// individual player rows live in Lineup (starters/bench, captain, jersey).
model MatchTeamSheet {
  id        Int      @id @default(autoincrement())
  fixtureId Int
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId    Int
  formation String?  @db.VarChar(20) // e.g. 4-3-3, 4-4-2
  coachName String?  @db.VarChar(200)
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([fixtureId, teamId])
}

// Per-team match statistics, entered by the league admin / reporter.
model MatchStat {
  id              Int      @id @default(autoincrement())
  fixtureId       Int
  fixture         Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId          Int
  possession      Int? // %
  shots           Int?
  shotsOnTarget   Int?
  shotsInsideBox  Int?
  shotsOutsideBox Int?
  corners         Int?
  offsides        Int?
  fouls           Int?
  yellowCards     Int?
  redCards        Int?
  gkSaves         Int?
  passAccuracy    Int? // %
  xg              Decimal? @db.Decimal(4, 2)
  updatedAt       DateTime @updatedAt

  @@unique([fixtureId, teamId])
}

model MatchEvent {
  id          Int       @id @default(autoincrement())
  fixtureId   Int
  fixture     Fixture   @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId    Int?
  player      Player?   @relation("PlayerEvent", fields: [playerId], references: [id], onDelete: SetNull)
  player2Id   Int?
  player2     Player?   @relation("SubEvent", fields: [player2Id], references: [id], onDelete: SetNull)
  refereeName String?
  teamId      Int?
  eventType   EventType
  minute      Int?      @db.SmallInt
  extraTime   Int       @default(0) @db.SmallInt
  description String?   @db.VarChar(300)
  createdAt   DateTime  @default(now())

  @@index([fixtureId])
  @@index([playerId])
}

enum EventType {
  /// Free-text commentary from the reporter — carries no scoring or disciplinary
  /// meaning, only a `description`. Kept distinct so match logic that sums goals
  /// or counts cards never has to exclude it by name.
  COMMENTARY
  GOAL
  OWN_GOAL
  PENALTY
  RED_CARD
  YELLOW_CARD
  SUBSTITUTION
  INJURY
  VAR
  KICKOFF
  HALFTIME
  FULLTIME
  EXTRA_TIME
}

model Lineup {
  id        Int     @id @default(autoincrement())
  fixtureId Int
  fixture   Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId    Int
  playerId  Int
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position  String? @db.VarChar(50)
  jerseyNo  Int?    @db.SmallInt
  isStarter Boolean @default(true)
  isCaptain Boolean @default(false)

  @@unique([fixtureId, playerId])
}

model LiveMatchState {
  fixtureId Int      @id
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  /// Last minute an event was logged at. Kept for clients that only read a number;
  /// the authoritative clock is derived from periodStartedAt below.
  minute    Int      @default(0) @db.SmallInt
  homeScore Int      @default(0) @db.SmallInt
  awayScore Int      @default(0) @db.SmallInt
  status    String   @default("live") @db.VarChar(30)
  lastEvent String?  @db.VarChar(300)
  updatedAt DateTime @updatedAt

  // ── Match clock ──
  // The clock runs from a timestamp rather than being ticked and stored, so it is
  // correct after a refresh, on a second device, and for a viewer who loads the
  // page mid-half. Reporters were previously typing the minute on every event.
  period           MatchPeriod @default(PRE)
  /// When the current period kicked off. Null while the clock is stopped
  /// (before kick-off, at half time, after full time).
  periodStartedAt  DateTime?
  /// Minute the current period counts up from: 0 in the first half, 45 in the
  /// second, so the second half resumes at 45' rather than restarting at 0.
  periodBaseMinute Int         @default(0) @db.SmallInt
  /// Stoppage time the referee signalled for the current period. Entered by the
  /// reporter; it does not stop the clock, it tells everyone how long is left.
  addedMinutes     Int         @default(0) @db.SmallInt
}

enum MatchPeriod {
  PRE
  FIRST_HALF
  HALF_TIME
  SECOND_HALF
  FULL_TIME
}

model Standing {
  id           Int      @id @default(autoincrement())
  leagueId     Int
  league       League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId       Int
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int      @default(0)
  won          Int      @default(0)
  drawn        Int      @default(0)
  lost         Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  points       Int      @default(0)
  form         String   @default("") @db.VarChar(20)
  updatedAt    DateTime @updatedAt

  @@unique([leagueId, teamId])
}

model TopScorer {
  id        Int      @id @default(autoincrement())
  leagueId  Int
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerId  Int      @unique
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  goals     Int      @default(0)
  assists   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([leagueId])
  @@index([teamId])
}

model Transfer {
  id           Int          @id @default(autoincrement())
  playerId     Int
  player       Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromTeamId   Int?
  fromTeam     Team?        @relation("TransferFrom", fields: [fromTeamId], references: [id], onDelete: SetNull)
  toTeamId     Int
  toTeam       Team         @relation("TransferTo", fields: [toTeamId], references: [id])
  transferDate DateTime?    @db.Date
  transferType TransferType @default(PERMANENT)
  fee          Decimal?     @db.Decimal(12, 2)
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())

  @@index([playerId])
  @@index([toTeamId])
  @@index([fromTeamId])
}

enum TransferType {
  PERMANENT
  LOAN
  FREE
  RETURN_FROM_LOAN
}

model TeamRegistration {
  id          Int       @id @default(autoincrement())
  teamId      Int
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leagueId    Int
  league      League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  status      RegStatus @default(PENDING)
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  Int?
  notes       String?   @db.Text

  @@unique([teamId, leagueId])
  @@index([leagueId])
}

enum RegStatus {
  PENDING
  APPROVED
  REJECTED
}

model News {
  id         Int          @id @default(autoincrement())
  sportId    Int?
  leagueId   Int?
  league     League?      @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  title      String       @db.VarChar(300)
  slug       String?      @db.VarChar(320)
  excerpt    String?      @db.Text
  body       String?      @db.Text
  coverImage String?      @db.VarChar(300)
  authorId   Int?
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

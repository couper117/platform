}

// ── Data protection (Law N° 058/2021) ──

/// A request from a data subject exercising a right under arts. 18–24. Logged so
/// the statutory thirty-day response deadline is visible and auditable.
model DataSubjectRequest {
  id           Int             @id @default(autoincrement())
  type         DsrType
  subjectName  String          @db.VarChar(200)
  subjectEmail String?         @db.VarChar(200)
  subjectPhone String?         @db.VarChar(50)
  /// Who is asking: the person themselves, or a parent/guardian acting for a child.
  relationship DsrRelationship @default(SELF)
  /// Which records the request concerns, in the requester's own words.
  details      String?         @db.Text
  status       DsrStatus       @default(RECEIVED)
  handledBy    Int?
  responseNote String?         @db.Text
  createdAt    DateTime        @default(now())
  /// createdAt + 30 days (arts. 18, 19, 20, 23, 24).
  dueAt        DateTime
  closedAt     DateTime?

  @@index([status])
  @@index([dueAt])
}

enum DsrType {
  ACCESS
  RECTIFICATION
  ERASURE
  OBJECTION
  PORTABILITY
  RESTRICTION
}

enum DsrRelationship {
  SELF
  PARENT_OR_GUARDIAN
  LEGAL_REPRESENTATIVE
}

enum DsrStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// UMUGANDA
//
// Umuganda is Rwanda's monthly community work morning, held on the last
// Saturday of the month. The platform TREATS THE LAST SATURDAY AS EXPECTED,
// never as gospel: authorities do move it, so every generated row can be
// confirmed, moved or disabled by an administrator, and the administrator's
// decision always wins over the calculation.
// ─────────────────────────────────────────────────────────────────────────────

model UmugandaDay {
  id    Int      @id @default(autoincrement())
  // Stored as a DATE (no clock component) so equality with a fixture's calendar
  // day is not at the mercy of the server's timezone offset.
  date  DateTime @db.Date
  month Int      @db.SmallInt
  year  Int      @db.SmallInt

  title       String? @db.VarChar(200)
  description String? @db.Text

  status UmugandaStatus @default(EXPECTED)
  source UmugandaSource @default(GENERATED)

  // Kept as explicit booleans (rather than derived from `source`) because the
  // spec asks to distinguish "was generated" from "a human has since edited it".
  autoGenerated Boolean @default(true)
  overridden    Boolean @default(false)

  // Community-work window, local time. Defaults to the national 08:00-11:00.
  startTime String @default("08:00") @db.VarChar(5)
  endTime   String @default("11:00") @db.VarChar(5)

  createdById Int?
  createdBy   User? @relation("UmugandaAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixtures    Fixture[]
  akcFixtures AkcFixture[]
  notices     UmugandaNotice[]

  // One Umuganda per calendar day, so regenerating a month is idempotent.
  @@unique([date])
  @@index([year, month])
  @@index([status])
}

enum UmugandaStatus {
  EXPECTED // auto-calculated last Saturday, not yet confirmed by an admin
  CONFIRMED // an admin has confirmed this is the official date
  MOVED // authorities moved it; this row carries the corrected date
  DISABLED // no Umuganda this month (or a generated row an admin switched off)
}

enum UmugandaSource {
  GENERATED // produced by the last-Saturday calculation
  ADMIN // created by hand (special / extra Umuganda date)
}

// What an administrator decided about a match that collides with Umuganda.
// The system NEVER decides this on its own and never auto-cancels a match.
enum UmugandaDecision {
  CONTINUE // goes ahead as scheduled
  MOVED // rescheduled to another date/time
  AFTER_UMUGANDA // same day, kicks off after community work
  AFFECTED // flagged as affected, resolution still pending
}

// A public-facing announcement generated when Umuganda affects a match.
// `dedupeKey` is unique: it is what stops the same notice being raised twice
// for the same fixture and decision.
model UmugandaNotice {
  id            Int         @id @default(autoincrement())
  umugandaDayId Int
  umugandaDay   UmugandaDay @relation(fields: [umugandaDayId], references: [id], onDelete: Cascade)

  fixtureId    Int?
  akcFixtureId Int?

  kind  UmugandaNoticeKind @default(GENERAL)
  title String             @db.VarChar(300)
  body  String             @db.Text

  // Snapshot of what changed, so the notice still reads correctly even after
  // the fixture is edited again later.
  originalDate DateTime?
  newDate      DateTime?
  reason       String?   @db.VarChar(500)

  published Boolean @default(true)
  dedupeKey String  @unique @db.VarChar(200)

  createdAt DateTime @default(now())

  @@index([umugandaDayId])
  @@index([published, createdAt])
}

enum UmugandaNoticeKind {
  // Mirrors UmugandaDecision one-for-one so a client can translate the notice
  // itself rather than displaying the English sentence the server stored.
  // GENERAL stays for free-text announcements an administrator writes.
  GENERAL
  CONTINUE
  RESCHEDULED
  AFTER_UMUGANDA
  AFFECTED
}

// ═══════════════════════════════════════════════════════════════════════════
// Reporter / agent
// ═══════════════════════════════════════════════════════════════════════════

/// The reporter as a person, as distinct from ReporterAssignment, which is the
/// link between one reporter and one fixture.
///
/// A league admin deciding who to send to a match needs to know what sports the
/// reporter covers, where they are, and whether they are free. The assignment
/// table cannot answer any of that, because it only exists once the decision has
/// already been made.
model ReporterProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sports this reporter can cover. A basketball reporter should not be offered
  /// for a cycling stage — the console adapts to the sport, the person does not.
  sportIds     Int[]                @default([])
  location     String?              @db.VarChar(200)
  bio          String?              @db.Text
  yearsActive  Int?                 @db.SmallInt
  availability ReporterAvailability @default(AVAILABLE)
  /// Set alongside BUSY so an admin sees when the reporter frees up.
  busyUntil    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([availability])
}

enum ReporterAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

// ═══════════════════════════════════════════════════════════════════════════
// Notifications
// ═══════════════════════════════════════════════════════════════════════════

/// An in-app notification, addressed either to a signed-in user or to an
/// anonymous device token — so someone who followed a team without creating an
/// account can still be told their match is about to start.
model Notification {
  id        Int     @id @default(autoincrement())
  userId    Int?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Anonymous recipient. The same opaque token the Favorite table uses; never
  /// an IP address or anything else that identifies a person (Law 058/2021 art. 3).
  anonToken String? @db.VarChar(64)

  kind  NotificationKind
  title String           @db.VarChar(200)
  body  String?          @db.Text
  /// Where tapping it goes, e.g. /matches/12. Relative, so it survives a move
  /// between hosts and works identically in the mobile shell.
  link  String?          @db.VarChar(300)

  /// What it concerns. Lets a postponed match withdraw its own reminders, and
  /// stops the same reminder being queued twice.
  subjectType String? @db.VarChar(40)
  subjectId   Int?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([anonToken, readAt])
  @@index([subjectType, subjectId])
}

enum NotificationKind {
  MATCH_UPCOMING
  MATCH_STARTING
  MATCH_RESULT
  MATCH_UPDATE
  MATCH_POSTPONED
  MATCH_CANCELLED
  LINEUP_PUBLISHED
  FIXTURE_ASSIGNED
  DOCUMENT_REVIEWED
  ORGANISATION_STATUS
  GENERAL
}

// ═══════════════════════════════════════════════════════════════════════════
// Favourites
// ═══════════════════════════════════════════════════════════════════════════

/// A followed team. Owned by either a signed-in user or an anonymous device
/// token — never both — so following a team never forces an account. The two
/// unique constraints are what keep a follower count honest when a flaky
/// connection retries the same request.
model Favorite {
  id     Int  @id @default(autoincrement())
  teamId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId    Int?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonToken String? @db.VarChar(64)

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@unique([teamId, anonToken])
  @@index([anonToken])
}

// ═══════════════════════════════════════════════════════════════════════════
// Onboarding requests
// ═══════════════════════════════════════════════════════════════════════════

/// A club, school, federation or sport asking to join the platform. Nothing is
/// created from one of these until a Super Admin approves it, so a request is a
/// queue entry and never a half-made organisation.
model PlatformRequest {
  id           Int         @id @default(autoincrement())
  kind         RequestKind
  organisation String      @db.VarChar(200)
  contactName  String      @db.VarChar(200)
  contactEmail String      @db.VarChar(200)
  contactPhone String?     @db.VarChar(50)
  sportId      Int?
  details      String?     @db.Text

  status       RequestStatus @default(PENDING)
  reviewedById Int?
  reviewedBy   User?         @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  decisionNote String?       @db.Text
  createdAt    DateTime      @default(now())

  @@index([status])
}

enum RequestKind {
  CLUB
  SCHOOL
  FEDERATION
  SPORT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════════
// Media
// ═══════════════════════════════════════════════════════════════════════════

/// A record of an uploaded file, so it can be listed, attributed, replaced and
/// deleted. The bytes live wherever STORAGE_DRIVER puts them (local disk or
/// Cloudinary); this row is what makes them findable afterwards, which an
/// orphaned URL in a VarChar column never is.
model Media {
  id       Int    @id @default(autoincrement())
  url      String @db.VarChar(500)
  mimeType String @db.VarChar(100)
  bytes    Int

  /// What it belongs to — "team", "federation", "ad", "player". A string rather
  /// than a foreign key per type, so a new owner kind needs no migration.
  ownerType String  @db.VarChar(40)
  ownerId   Int?
  purpose   String? @db.VarChar(40) // logo | cover | avatar | banner | document

  uploadedById Int?
  uploadedBy   User? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AI models
// ═══════════════════════════════════════════════════════════════════════════

/// Registry of AI models the platform is allowed to call. Configuration only —
/// credentials stay in the environment and are deliberately absent here.
model AiModel {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  provider  String   @db.VarChar(60)
  modelId   String   @db.VarChar(120)
  purpose   String?  @db.VarChar(200)
  enabled   Boolean  @default(false)
  config    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

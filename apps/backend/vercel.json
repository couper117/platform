{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh ./scripts-build.sh",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/end-stalled-matches",
      "schedule": "0 3 * * *"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && npx prisma migrate deploy",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/end-stalled-matches",
      "schedule": "*/10 * * * *"
    }
  ]
}

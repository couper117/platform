{
  "name": "rnsp-api",
  "version": "1.0.0",
  "description": "RNSP Express API (TypeScript)",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:extra": "tsx prisma/seed-extra.ts",
    "seed:federations": "tsx prisma/seed-federations.ts",
    "seed:colors": "tsx prisma/seed-colors.ts",
    "seed:lineups": "tsx prisma/seed-lineups.ts",
    "seed:showcases": "tsx prisma/seed-showcases.ts",
    "seed:all": "tsx prisma/seed.ts && tsx prisma/seed-extra.ts && tsx prisma/seed-federations.ts && tsx prisma/seed-colors.ts && tsx prisma/seed-lineups.ts && tsx prisma/seed-showcases.ts",
    "vercel-build": "sh ./scripts-build.sh",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:smoke": "node --test test/smoke.test.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts && tsx prisma/seed-extra.ts && tsx prisma/seed-federations.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pusher": "^5.2.0",
    "sharp": "^0.33.4",
    "slugify": "^1.6.6",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}

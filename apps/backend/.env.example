# Copy to api/.env and fill in real values. api/.env is gitignored — keep it
# that way, and keep it out of cloud-synced folders (OneDrive, Dropbox, iCloud):
# a synced .env puts the live DB password and JWT secret in a third-party
# account and in that provider's file-version history.

PORT=5000
NODE_ENV=development

# Database
# ── Local dev: point both at your local Postgres (same URL is fine) ──
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rnsp"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rnsp"
#
# ── Production (Supabase): the direct db.<ref>.supabase.co host is RETIRED.
#    Use the Supavisor pooler for the app, and the direct/session port for
#    migrations. Region is eu-central-1 here — match your project's region. ──
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your_super_secret_jwt_key_at_least_32_chars_long"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Pusher (Real-time)
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=your_cluster

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM="RNSP <noreply@rnsp.rw>"

# Payments (Flutterwave) — ALL OPTIONAL. Leave blank to run the payment provider
# in safe "sandbox" mode (no live charges; the webhook fails closed). Set all
# three to go live. FLW_WEBHOOK_HASH is the dashboard "secret hash" that
# Flutterwave echoes in the `verif-hash` header of each webhook call.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_HASH=
# FLW_BASE_URL=https://api.flutterwave.com/v3
# PAYMENT_CURRENCY=RWF

# Frontend
FRONTEND_URL=http://localhost:5173

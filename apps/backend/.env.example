# Copy to api/.env and fill in real values. api/.env is gitignored — keep it
# that way, and keep it out of cloud-synced folders (OneDrive, Dropbox, iCloud):
# a synced .env puts the live DB password and JWT secret in a third-party
# account and in that provider's file-version history.

PORT=5000
NODE_ENV=development

# Database
# ── Local dev: point both at your local Postgres (same URL is fine) ──
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rnsp"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rnsp"
#
# ── DATA LOCALISATION — Law N° 058/2021 arts. 48 and 50 ──
# Personal data may be stored outside Rwanda ONLY with a valid registration
# certificate from the supervisory authority (NCSA), and transfers need a written
# contract with the processor. The eu-central-1 example below is Frankfurt. This
# platform holds schoolchildren's data — confirm the certificate is in place, or
# host in Rwanda. See docs/DATA_PROTECTION.md §6.1.
#
# ── Production (Supabase): the direct db.<ref>.supabase.co host is RETIRED.
#    Use the Supavisor pooler for the app, and the direct/session port for
#    migrations. Region is eu-central-1 here — match your project's region. ──
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your_super_secret_jwt_key_at_least_32_chars_long"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Pusher (Real-time)
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=your_cluster

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM="RNSP <noreply@rnsp.rw>"

# Payments (Flutterwave) — ALL OPTIONAL. Leave blank to run the payment provider
# in safe "sandbox" mode (no live charges; the webhook fails closed). Set all
# three to go live. FLW_WEBHOOK_HASH is the dashboard "secret hash" that
# Flutterwave echoes in the `verif-hash` header of each webhook call.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_HASH=
# FLW_BASE_URL=https://api.flutterwave.com/v3
# PAYMENT_CURRENCY=RWF

# ── Data residency (Law N° 058/2021 arts. 48-50) ──
# Declare where personal data is stored. The server checks this at boot and, in
# production, refuses to start on an unlawful combination.
#   rwanda    data is hosted in Rwanda
#   offshore  data is hosted elsewhere - requires NCSA_REGISTRATION_NUMBER below
DATA_RESIDENCY=rwanda
# The registration certificate from the supervisory authority (NCSA) that permits
# storing personal data outside Rwanda. Required when DATA_RESIDENCY=offshore.
NCSA_REGISTRATION_NUMBER=

# Frontend
FRONTEND_URL=http://localhost:5173

# Close matches a reporter left live (clock stuck past full time). Reports only
# unless this is true; check first with `npm run matches:end-stalled`.
AUTO_END_STALLED_MATCHES=false

# Where uploaded media goes. 'cloudinary' (default) or 'local'. Local writes to
# the served /uploads directory and needs no third-party account, which is what
# data-sovereignty requires — but local disk is ephemeral on serverless hosts.
STORAGE_DRIVER=local

# Payments (Flutterwave). Without the FLW_* keys above the provider runs in a
# safe sandbox: no live charges, no real payment links.
FLW_BASE_URL=https://api.flutterwave.com/v3
PAYMENT_CURRENCY=RWF

# Shared secret for scheduled work (the stalled-match sweep). Vercel sends it as
# a bearer token on cron invocations; leave it unset and those endpoints refuse
# everything rather than defaulting to open.
CRON_SECRET=

# ── AI assistant ──────────────────────────────────────────────────────────────
# The floating assistant on the public site, and the AI Configuration section of
# the admin console. ALL OPTIONAL: with nothing set here an administrator can
# paste a key into AI Configuration instead, where it is stored encrypted.
#
# Gemini is the default provider. A key set here is the deployment fallback; a
# key entered in the console takes precedence over it.
GEMINI_API_KEY=
# Other supported providers — set only the one you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Encrypts keys typed into the console before they are written to the database.
# Falls back to JWT_SECRET when unset. Set it separately if the two should rotate
# on different schedules — rotating JWT_SECRET without this makes stored AI keys
# unreadable (the console says so and falls back to the variables above).
AI_SECRET_KEY=

# Frontend environment (Vite) — copy to .env and fill in.

# Base URL of the RNSP API (include the /api/v1 prefix)
VITE_API_URL=http://localhost:5000/api/v1

# App display name
VITE_APP_NAME="Rwanda National Sports Platform"

# Pusher (real-time live scores). Leave blank to disable real-time (app still works).
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=

# Set to "true" to build the self-contained demo (swaps the API for a local mock
# adapter). Leave unset/empty for normal builds that talk to VITE_API_URL.
VITE_DEMO=

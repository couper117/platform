# Loaded by `vite --mode demo` (npm run dev:demo / npm run build:demo).
#
# Runs the REAL app against the local dataset in src/api/demo — no backend, no
# database, no Postgres. Nothing secret lives in here, which is why it is
# committed: it only flips a switch that src/api/client.ts already reads.
VITE_DEMO=true
